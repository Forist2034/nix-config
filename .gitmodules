[submodule "private"]
	path = private
	url = ../private.git

[includeIf "onbranch:hosts/nixos-desktop0"]
  path = ./hosts/nixos-desktop0/gitmodules

[includeIf "onbranch:hosts/nixos-laptop0"]
  path = ./hosts/nixos-laptop0/gitmodules

[includeIf "onbranch:hosts/nixos-tablet0"]
  path = ./hosts/nixos-tablet0/gitmodules

[includeIf "onbranch:master"]
  path = ./master.gitmodules
